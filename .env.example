# PINDOM environment — copy to `.env` and fill in real values.
# `.env` is gitignored; this file is the committed contract for what keys exist.
#
# EXPO_PUBLIC_* keys are inlined into the JS bundle at build time and are
# therefore PUBLIC. Never put a secret behind an EXPO_PUBLIC_ prefix.

# ── Data source ──
# true  → src/lib/repositories/ serves typed fixtures from src/mocks/.
#         No Firebase packages, no config files, no project access required.
# false → repositories call Firebase.
#
# Keep this switch after integration: it is how you develop offline, build a
# screen whose Cloud Function is not deployed, and demo if the venue wifi dies.
# See docs/how-to/connect-the-app-to-firebase.md.
EXPO_PUBLIC_USE_MOCKS=true

# One of: dev | staging | prod. Defaults to `prod` when unset.
EXPO_PUBLIC_ENV=dev

# ── Naver Map ──
# Client ID from https://console.ncloud.com — Maps > Application. Tick
# **Dynamic Map** only; the app calls no Directions or Geocoding API, and the
# course route is drawn from coordinates the client already has.
# Must be registered against the iOS/Android bundle IDs in app.config.ts
# (com.zoyoong.pindom). The skkuverse key will NOT work here.
# The Client *Secret* goes nowhere: it signs server-side API calls, and the map
# SDK never uses it.
# A wrong or missing ID fails silently with a blank map — check native logs.
# It is read at build time into Info.plist, so changing it needs a native
# rebuild (`npx expo prebuild --platform ios && yarn ios`), not a reload.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# ── Firebase ──
# Nothing goes here. Firebase carries its project identity in the platform
# config files, not in an environment variable:
#
#   google-services.json       (Android)
#   GoogleService-Info.plist   (iOS)
#
# Both are gitignored and come from the backend developer, who owns the project.
# Neither is a secret — they ship inside the app bundle — so the app's security
# comes from Firestore rules, not from hiding them.
# See docs/how-to/connect-the-app-to-firebase.md.
#
# The one Firebase value that IS an env var: where the Cloud Functions live.
# asia-northeast3 (Seoul) is confirmed with the backend developer. The client
# SDK defaults to us-central1, so leaving this wrong fails as `not-found` on
# every callable. Defaults to asia-northeast3 when unset — see src/lib/config.ts.
EXPO_PUBLIC_FUNCTIONS_REGION=asia-northeast3

# ── Superseded ──
# EXPO_PUBLIC_BASE_URL was the REST backend's address. ADR 0005 replaced REST
# with Firebase. src/lib/api/config.ts still reads it, but nothing calls it.
# EXPO_PUBLIC_BASE_URL=
