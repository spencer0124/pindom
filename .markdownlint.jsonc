// markdownlint rules for pindom.
//
// Adapted from skkuverse-app's `.markdownlint.jsonc`. In that repo the file is a
// hash-locked contract vendored from an umbrella repository via
// `sync_contracts.py` and pinned in `.contracts.lock.json`. pindom is not part
// of that umbrella, so this is a plain local file: edit it here, freely.
//
// Rules live here; the paths to lint live in `.markdownlint-cli2.jsonc`,
// because which paths a repo lints is genuinely repo-specific and the rule set
// is not.
{
  "default": true,

  // ── Disabled: rules that fight this workspace's prose style ──
  "MD013": false, // line-length — prose is wrapped by meaning, not column count
  "MD033": false, // inline HTML — <details> and <br> are used deliberately
  "MD024": { "siblings_only": true }, // duplicate headings — banned only among siblings, so timeline and per-screen patterns work
  "MD036": false, // emphasis-as-heading — a run-in heading opening a list item is the documented idiom
  "MD028": false, // blanks-inside-blockquote — `> summary` followed by `> [!NOTE]` is the documented doc skeleton

  // ── Enforced. Listed explicitly even where `default: true` already covers
  //    them, so the intent is on the record rather than inherited by accident.
  "MD001": true, // no skipped heading levels
  "MD003": { "style": "atx" }, // `#` headings only
  "MD025": { "front_matter_title": "" }, // exactly one H1 per document; the frontmatter `title` is not counted
  "MD040": true, // every fenced code block declares a language
  "MD041": false // first line need not be a heading — every document starts with frontmatter
}
