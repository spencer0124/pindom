# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds (CNG — regenerated by expo prebuild)
/ios
/android
.kotlin/
*.orig.*

# Environment — never commit real values; .env.example is the committed contract
.env
.env.local
.env.*.local
.envrc

# Signing / credentials
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
credentials.json
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Firebase 에뮬레이터가 실행할 때마다 새로 쓰는 로그
firebase-debug.log
firestore-debug.log
ui-debug.log

# Build artifacts
*.ipa
*.aab
*.tsbuildinfo

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code local state (per-machine) — but skills are project workflow, not
# machine state, so they travel with the repo. `.claude/*` rather than `.claude/`
# because git will not descend into an excluded directory to honour a negation.
.claude/*
!.claude/skills/

# explain-diff plugin output — generated HTML walkthroughs, regenerable
explain-diff/
